# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime output
traces/*.jsonl
# ...except the trace kept as committed evidence. The rubric asks for committed artifacts, and a
# claim about latency is worth what the file behind it is worth. Audited for secrets before adding.
!evidence/*.jsonl
recordings/
*.wav
*.mp3
*.log
# The negations must come AFTER the patterns they undo -- git applies the LAST matching rule, so
# putting `!evidence/*.log` above `*.log` silently did nothing.
!evidence/*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

*.bak

# The running system's working copy of the hotel. Bookings land here and never in the committed
# database -- see LIVE_DB_PATH in aether/hotel/db.py. Reset with scripts/reset_hotel_db.py.
data/*.live.db
data/*.live.db.partial
*.db-journal

# What the model has said about things the hotel has no row for. Never committed: it is one
# deployment's guesses, not part of the hotel -- see aether/hotel/learned.py.
data/aether_learned.db

# Locally installed Claude Code skills (nextlevelbuilder/ui-ux-pro-max-skill and friends): 263
# files and ~11 MB of somebody else's repository. It is tooling for writing the frontend, not part
# of AETHER, and redistributing it inside a competition entry is not ours to do. Removing it after
# a push would mean rewriting history, so it is kept out from the start.
.claude/
