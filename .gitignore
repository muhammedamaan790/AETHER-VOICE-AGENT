# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime output
traces/*.jsonl
# ...except the trace kept as committed evidence. The rubric asks for committed artifacts, and a
# claim about latency is worth what the file behind it is worth. Audited for secrets before adding.
!evidence/*.jsonl
recordings/
*.wav
*.mp3
*.log
# The negations must come AFTER the patterns they undo -- git applies the LAST matching rule, so
# putting `!evidence/*.log` above `*.log` silently did nothing.
!evidence/*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

*.bak

# The running system's working copy of the hotel. Bookings land here and never in the committed
# database -- see LIVE_DB_PATH in aether/hotel/db.py. Reset with scripts/reset_hotel_db.py.
data/*.live.db
data/*.live.db.partial
*.db-journal
