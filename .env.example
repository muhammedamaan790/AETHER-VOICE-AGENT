# AETHER — environment template.
# Copy to .env and fill in locally. NEVER commit .env. NEVER show these values on screen.
#
# NOTE: do NOT put a comment on the same line as a value. python-dotenv treats everything after
# `=` as the value, so `RIME_MODEL=   # TODO` sets the model to the literal string "# TODO".
# Comments go on their own line, as below.

# ---------------------------------------------------------------------------
# Rime TTS — primary and sole speech provider in the judged path.
# Contract VERIFIED by a human against a live 200 response that played real audio.
# The API key is a secret: leave it blank here and set it only in .env.
# ---------------------------------------------------------------------------
RIME_API_KEY=
RIME_API_URL=https://users.rime.ai/v1/rime-tts
# mistv3 + astra + eng is VERIFIED against Rime's live catalog
# (https://users.rime.ai/data/voices/voice_details.json, 863 entries: mistv3 has 83, and `astra`
# is listed under mistv3, mistv2 and arcana). It measured 308 ms warm first-audio vs mistv2's
# 488 ms on the same voice with 0 errors, and speaks roughly a third slower.
# Which of the two SOUNDS better has not been judged and is not claimed here.
# mistv2 remains a one-line fallback: change this value back.
RIME_MODEL=mistv3
RIME_VOICE=astra
RIME_LANGUAGE=eng

# Transport. Blank (default) = WebSocket /ws3 streaming: PCM at the AudioGate's own rate, one
# persistent socket reused across turns, and mid-utterance stop on a fence. Set to `http` to use
# the blocking MP3 endpoint above instead. Both are Rime — this is not a fallback provider (R9.4).
RIME_TRANSPORT=
# Override only to point at a different Rime WebSocket host. Blank uses the built-in default.
RIME_WS_URL=

# Sentence streaming: speak each sentence as the model produces it, instead of waiting for the
# whole reply. Blank/1 = on (default). Set to 0 to use the blocking path with its retry behaviour.
# Only providers that implement respond_stream stream; the others use the blocking path regardless.
AETHER_LLM_STREAMING=

# ---------------------------------------------------------------------------
# STT — faster-whisper, local CPU. No credential required.
# ---------------------------------------------------------------------------
STT_PROVIDER=faster-whisper
STT_MODEL=base.en
STT_API_KEY=

# ---------------------------------------------------------------------------
# LLM — reasoning / general knowledge path. Four providers are supported.
#
# LLM_PROVIDER selects one explicitly: groq | anthropic | openai | gemini
#   - only that provider's API key is read
#   - if its key is missing, AETHER raises a clear configuration error
#   - it NEVER silently falls back to a different provider
#
# Leave LLM_PROVIDER blank to auto-select the first provider that has a key, in this order:
#   groq -> anthropic -> openai -> gemini      (groq first: lowest latency for voice)
# If none has a key, aether/llm.py runs the labelled stub, which cannot answer questions.
#
# Each *_MODEL is optional; the default in aether/llm.py is used when blank.
# Groq and OpenAI have compatible wire formats but are SEPARATE providers with separate keys.
# ---------------------------------------------------------------------------
LLM_PROVIDER=

# NOTE: llama-3.3-70b-versatile is DECOMMISSIONED (404). Set a current Groq model here.
GROQ_API_KEY=
GROQ_MODEL=

# default: claude-opus-5   (set a smaller model here if you want lower voice latency)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# default: gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=

# default: gemini-flash-lite-latest  (measured: 3.8-flash failed 2/3 calls and was ~17x slower)
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
AETHER_TRACE_DIR=traces
AETHER_LOG_LEVEL=INFO

# UNUSED. The interruption classifier (aether/classify) turned out to need no threshold: it is
# closed-set and whole-utterance, so it either recognises a phrase exactly or falls through to
# REPLACEMENT, which fences. There is no confidence score to compare against. Kept here, named and
# marked dead, rather than silently deleted -- `RuntimeConfig` still parses it.
AETHER_CLASSIFIER_CONFIDENCE_THRESHOLD=

# VAD tuning. Blank uses the code defaults: aggressiveness 2, 20 ms frames, 2-frame onset.

# Absolute peak RMS a voiced run must reach to count as speech aimed at THIS microphone.
# Blank uses a conservative default. This is genuinely device-specific: a floor calibrated on one
# mic rejected real speech on the same machine after a gain/distance change. Derive yours with:
#   python scripts/calibrate_mic.py
AETHER_SPEECH_FLOOR=

AETHER_VAD_AGGRESSIVENESS=
AETHER_VAD_ONSET_MS=

# Audio endpoints. Blank = let PortAudio choose, which is NOT always the device you are using:
# on one machine the default input was a headset mic capturing near-silence while the working mic
# was index 2. An explicitly named device that cannot be opened is an error, never a silent
# fallback. List devices with:
#   python -c "import sounddevice; print(sounddevice.query_devices())"
# Both are printed at startup as the resolved endpoint.
AETHER_INPUT_DEVICE=
AETHER_OUTPUT_DEVICE=

# ---------------------------------------------------------------------------
# LiveKit — TRANSPORT ONLY. It carries phone audio in and out; it is not the brain.
#
# The worker uses `livekit.rtc` directly (subscribe to the caller's track, publish one of ours)
# and deliberately NOT `AgentSession`, which brings its own STT, LLM, TTS and turn detection and
# would bypass the GenerationRegistry, the AudioGate and the whole fence.
#
# All three are secrets in the sense that they identify a project: put real values in .env only.
# `LiveKitConfig` reports only the NAMES of missing variables, never a value.
#
#   LIVEKIT_URL         wss://<project>.livekit.cloud
#   LIVEKIT_API_KEY     project API key
#   LIVEKIT_API_SECRET  project API secret
#
# Start the worker with:  python -m aether.telephony.agent dev
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# The AETHER console (the browser UI)
#
# Served by `python -m aether.web` locally, and by the telephony worker for the duration of a
# call so the same screen can be shown while a real caller is on the line.
# Set AETHER_WEB=0 to suppress it on the worker; the call is unaffected either way.
# ---------------------------------------------------------------------------
AETHER_WEB=
AETHER_WEB_HTTP_PORT=8760
AETHER_WEB_WS_PORT=8761

# Skip faster-whisper's HuggingFace revision check when constructing the model. Measured on this
# machine: a warm model load costs 672 ms with the check and 391 ms without, and the check is a
# network round-trip sitting on a call's setup path. Requires the model to be cached already, so
# leave it blank on a fresh clone and set it to 1 once `python -m aether.prewarm` has run once.
HF_HUB_OFFLINE=

# ---------------------------------------------------------------------------
# TEST-ONLY, and currently INERT. It is parsed into `RuntimeConfig.unsafe_mode` and read by
# nothing: no code path exists that lets a stale result reach output, so there is no check for it
# to disable. Setting it to 1 changes no behaviour today.
#
# That is why `test_unsafe_mode_leaks_stale_result` is skipped rather than passing -- the control
# condition it needs does not exist, and building a real bypass through the gate purely to fail a
# test is not a trade worth making (RULES.md R11). MUST stay 0/unset in any judged path.
# ---------------------------------------------------------------------------
AETHER_UNSAFE_MODE=0
