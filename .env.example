# AETHER — environment template.
# Copy to .env and fill in locally. NEVER commit .env. NEVER show these values on screen.
#
# NOTE: do NOT put a comment on the same line as a value. python-dotenv treats everything after
# `=` as the value, so `RIME_MODEL=   # TODO` sets the model to the literal string "# TODO".
# Comments go on their own line, as below.

# ---------------------------------------------------------------------------
# Rime TTS — primary and sole speech provider in the judged path.
# Contract VERIFIED by a human against a live 200 response that played real audio.
# The API key is a secret: leave it blank here and set it only in .env.
# ---------------------------------------------------------------------------
RIME_API_KEY=
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_MODEL=mistv2
RIME_VOICE=astra
RIME_LANGUAGE=eng

# ---------------------------------------------------------------------------
# STT — faster-whisper, local CPU. No credential required.
# ---------------------------------------------------------------------------
STT_PROVIDER=faster-whisper
STT_MODEL=base.en
STT_API_KEY=

# ---------------------------------------------------------------------------
# LLM — reasoning / general knowledge path. Four providers are supported.
#
# LLM_PROVIDER selects one explicitly: groq | anthropic | openai | gemini
#   - only that provider's API key is read
#   - if its key is missing, AETHER raises a clear configuration error
#   - it NEVER silently falls back to a different provider
#
# Leave LLM_PROVIDER blank to auto-select the first provider that has a key, in this order:
#   groq -> anthropic -> openai -> gemini      (groq first: lowest latency for voice)
# If none has a key, aether/llm.py runs the labelled stub, which cannot answer questions.
#
# Each *_MODEL is optional; the default in aether/llm.py is used when blank.
# Groq and OpenAI have compatible wire formats but are SEPARATE providers with separate keys.
# ---------------------------------------------------------------------------
LLM_PROVIDER=

# default: llama-3.3-70b-versatile   (llama-3.1-8b-instant is faster, less capable)
GROQ_API_KEY=
GROQ_MODEL=

# default: claude-opus-5   (set a smaller model here if you want lower voice latency)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# default: gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=

# default: gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
AETHER_TRACE_DIR=traces
AETHER_LOG_LEVEL=INFO

# Classifier confidence below this threshold takes the safe branch (fence).
# Blank until tuned from measured classifier behaviour (Day 3). Not a guessed default.
AETHER_CLASSIFIER_CONFIDENCE_THRESHOLD=

# VAD tuning. Blank uses the code defaults: aggressiveness 2, 20 ms frames, 2-frame onset.
AETHER_VAD_AGGRESSIVENESS=
AETHER_VAD_ONSET_MS=

# Audio endpoints. Blank = let PortAudio choose, which is NOT always the device you are using:
# on one machine the default input was a headset mic capturing near-silence while the working mic
# was index 2. An explicitly named device that cannot be opened is an error, never a silent
# fallback. List devices with:
#   python -c "import sounddevice; print(sounddevice.query_devices())"
# Both are printed at startup as the resolved endpoint.
AETHER_INPUT_DEVICE=
AETHER_OUTPUT_DEVICE=

# ---------------------------------------------------------------------------
# TEST-ONLY. Disables the Output Gate generation check so stale results leak.
# MUST be 0/unset in the demo and any judged path. See RULES.md R11.
# ---------------------------------------------------------------------------
AETHER_UNSAFE_MODE=0
